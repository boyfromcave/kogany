{
  "_comment": "Semgrep scan policy for kogany, the Ycash developers' fork of Zakura (contrib/semgrep/README.md). The same keys as ycash-dd, ycash6 and librustzcash6; rule paths, exclude_rules and the path lists are this repository's own.",
  "semgrep_version": "1.179.0",
  "rule_sources": [
    {
      "name": "semgrep-rules",
      "repo": "https://github.com/semgrep/semgrep-rules",
      "commit": "16b9e6d45f10649f6a531ec4838ed9924372c3bc",
      "license": "Semgrep Rules License v1.0: free, for our own use; fetched at scan time, never copied in, never quoted in PRs",
      "id_prefix": "",
      "paths": [
        "rust",
        "python/lang/security",
        "bash",
        "dockerfile",
        "generic/secrets",
        "yaml/github-actions"
      ]
    },
    {
      "name": "trailofbits",
      "repo": "https://github.com/trailofbits/semgrep-rules",
      "commit": "31390b3a99c04c81522d1b37c8d1900aa2dd4094",
      "license": "AGPL-3.0",
      "id_prefix": "trailofbits.",
      "paths": [
        "rs",
        "yaml/github-actions",
        "generic",
        "python"
      ]
    }
  ],
  "local_rules": "contrib/semgrep/rules",
  "categories": [
    "security"
  ],
  "exclude_rules": {},
  "audit_rules": {},
  "bucket_overrides": [],
  "non_production_paths": [
    "**/tests/**",
    "*/tests.rs",
    "**/testing/**",
    "**/benches/**",
    "**/examples/**",
    "**/proptest-regressions/**",
    "crates/zakura-test/**",
    "crates/zakura-sim/**",
    "qa/**",
    "testdata/**",
    "deploy/**",
    "docker/**",
    "scripts/**",
    ".github/scripts/**",
    ".github/workflows/scripts/**",
    "contrib/**",
    "docs/**",
    "*.md"
  ],
  "buckets": {
    "critical": {
      "sla_days": 7,
      "color": "b60205",
      "label": "semgrep:critical"
    },
    "high": {
      "sla_days": 30,
      "color": "d93f0b",
      "label": "semgrep:high"
    },
    "medium": {
      "sla_days": 90,
      "color": "fbca04",
      "label": "semgrep:medium"
    },
    "low": {
      "sla_days": 180,
      "color": "0e8a16",
      "label": "semgrep:low"
    }
  },
  "autofix_rules": [],
  "autofix_never_paths": [
    "crates/zakura-consensus/**",
    "crates/zakura-script/**",
    "crates/zakura-chain/src/transaction/**",
    "crates/zakura-chain/src/transaction.rs",
    "crates/zakura-chain/src/block/**",
    "crates/zakura-chain/src/block.rs",
    "crates/zakura-chain/src/parameters/**",
    "crates/zakura-chain/src/parameters.rs",
    "crates/zakura-chain/src/work/**",
    "crates/zakura-chain/src/work.rs",
    "crates/zakura-chain/src/transparent/**",
    "crates/zakura-chain/src/transparent.rs",
    "crates/zakura-chain/src/amount/**",
    "crates/zakura-chain/src/amount.rs",
    "crates/zakura-state/src/service/check/**",
    "crates/zakura-state/src/service/check.rs",
    "crates/zakura-state/src/service/finalized_state/**",
    "crates/zakura-state/src/service/finalized_state.rs",
    "crates/zakura-state/src/service/non_finalized_state/**",
    "crates/zakura-state/src/service/non_finalized_state.rs",
    "crates/zakura-header-chain/src/validation/**",
    "crates/kogany-*/**"
  ],
  "fail_on": [
    "critical"
  ],
  "base_branch": "upgrade/vault",
  "branch_prefix": "semgrep/",
  "pr_labels": [
    "security",
    "semgrep"
  ],
  "overdue_label": "sla:overdue"
}
